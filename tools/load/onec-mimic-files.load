-- ONEC_MIMIC -> Tantor 18: dbo._Files — таблица с LOB (~2 ГБ binary на 4 050 строк, в среднем
-- ~500 КБ на строку). Вынесена в отдельный файл по 13.7 §3; батчи уменьшены под объём строки,
-- workers снижен, чтобы не выжить память хоста (4 ГБ RAM, на нём же контейнеры MSSQL и Tantor).

LOAD DATABASE
     FROM mssql://{{MSSQL_USER}}:{{MSSQL_PWD}}@{{MSSQL_HOST}}:1433/{{MSSQL_DB}}
     INTO postgresql://{{PG_USER}}:{{PG_PWD}}@{{PG_HOST}}:5432/{{PG_DB}}

 WITH include no drop, create tables, create indexes, no foreign keys,
      create no schemas, reset no sequences, downcase identifiers, truncate,
      workers = 2, concurrency = 1,
      prefetch rows = 1000, batch rows = 200, batch size = 4MB,
      max parallel create index = 1,
      on error stop

 SET work_mem to '64MB',
     maintenance_work_mem to '512MB',
     statement_timeout to '0'

 CAST type nvarchar  to varchar keep typemod,
      type varchar   to varchar keep typemod,
      type numeric   to numeric keep typemod,
      type decimal   to numeric keep typemod,
      type datetime  to timestamp drop typemod,
      type datetime2 to timestamp drop typemod,
      type timestamp to bytea drop typemod

 ALTER SCHEMA 'dbo' RENAME TO 'public'

 INCLUDING ONLY TABLE NAMES LIKE '_Files' IN SCHEMA 'dbo'
