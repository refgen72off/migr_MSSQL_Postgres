-- ONEC_MIMIC -> Tantor 18: схема gen (27 таблиц-генераторов тестовых данных).
-- Вынесена в отдельный файл из-за БАГА pgloader: клауза EXCLUDING ... IN SCHEMA 'dbo'
-- в основном файле молча выбрасывает таблицы всех ДРУГИХ схем (WHERE строится как
-- AND (schema='dbo' AND name NOT LIKE ...) - для gen конъюнкт ложен).
-- Поэтому основной файл грузит только dbo, gen - этим файлом.

LOAD DATABASE
     FROM mssql://{{MSSQL_USER}}:{{MSSQL_PWD}}@{{MSSQL_HOST}}:1433/{{MSSQL_DB}}
     INTO postgresql://{{PG_USER}}:{{PG_PWD}}@{{PG_HOST}}:5432/{{PG_DB}}

 WITH include drop, create tables, create indexes, no foreign keys,
      create no schemas, reset no sequences, downcase identifiers,
      workers = 4, concurrency = 1,
      prefetch rows = 10000, batch rows = 5000, batch size = 10MB,
      max parallel create index = 1,
      on error stop

 SET work_mem to '64MB',
     maintenance_work_mem to '512MB',
     statement_timeout to '0'

 CAST type nvarchar  to varchar keep typemod,
      type varchar   to varchar keep typemod,
      type numeric   to numeric keep typemod,
      type decimal   to numeric keep typemod,
      type datetime  to timestamp drop typemod,
      type datetime2 to timestamp drop typemod,
      type timestamp to bytea drop typemod

 INCLUDING ONLY TABLE NAMES LIKE '%' IN SCHEMA 'gen';
